PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/booknook?retryWrites=true&w=majority
DB_NAME=booknook

# Required. Random, 32+ characters. The server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Browser origins allowed to call this API (comma separated). Set to your deployed frontend URL in production.
CORS_ORIGINS=http://localhost:3000
